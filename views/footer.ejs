<footer class="site-footer">
    <div class="footer-container">
        <!-- Brand Info Column -->
        <div class="footer-brand-col">
            <a href="/" class="brand-logo">
                <span class="brand-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                </span>
                <span class="brand-title">Blog App</span>
            </a>
            <p>
                A modern, premier publishing platform for creators and thinkers. Designed & developed with passion by <strong>Angad</strong>.
            </p>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
            <h4 class="footer-col-title">Navigation</h4>
            <ul class="footer-links-list">
                <li><a href="/">Home Feed</a></li>
                <li><a href="/new">Create New Post</a></li>
                <% if (!locals.isLoggedIn) { %>
                    <li><a href="/login">Sign In</a></li>
                    <li><a href="/register">Create Account</a></li>
                <% } else { %>
                    <li><a href="/logout">Logout</a></li>
                <% } %>
            </ul>
        </div>

        <!-- Community & Topics -->
        <div class="footer-col">
            <h4 class="footer-col-title">Explore Topics</h4>
            <ul class="footer-links-list">
                <li><a href="#feed-anchor" class="footer-topic-link" data-topic="technology">Technology</a></li>
                <li><a href="#feed-anchor" class="footer-topic-link" data-topic="design">Design & UX</a></li>
                <li><a href="#feed-anchor" class="footer-topic-link" data-topic="writing">Creative Writing</a></li>
                <li><a href="#feed-anchor" class="footer-topic-link" data-topic="code">AI & Engineering</a></li>
                <li><a href="#feed-anchor" class="footer-topic-link" data-topic="ideas">Perspectives</a></li>
            </ul>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
        <p class="copyright-text">
            © <%= new Date().getFullYear() %> <strong>Blog App</strong>. Designed & Developed by <strong>Angad</strong>. All rights reserved.
        </p>

        <div class="social-links-row">
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="GitHub">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Twitter">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
        </div>
    </div>
</footer>

<!-- Floating Back to Top Button -->
<button type="button" class="back-to-top-btn" id="back-to-top" aria-label="Back to top" title="Back to top">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"></polyline></svg>
</button>
